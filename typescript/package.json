{
  "name": "@keep-network/tbtc-v2.ts",
  "version": "4.0.0-dev",
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/core.d.ts",
      "default": "./dist/src/core.js"
    },
    "./solana": {
      "types": "./dist/src/lib/solana/index.d.ts",
      "default": "./dist/src/lib/solana/index.js"
    },
    "./starknet": {
      "types": "./dist/src/lib/starknet/index.d.ts",
      "default": "./dist/src/lib/starknet/index.js"
    },
    "./arbitrum": {
      "types": "./dist/src/lib/arbitrum/index.d.ts",
      "default": "./dist/src/lib/arbitrum/index.js"
    },
    "./base": {
      "types": "./dist/src/lib/base/index.d.ts",
      "default": "./dist/src/lib/base/index.js"
    },
    "./sui": {
      "types": "./dist/src/lib/sui/index.d.ts",
      "default": "./dist/src/lib/sui/index.js"
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "check:mainnet-deposit-parameters": "ts-node --files ./scripts/check-mainnet-deposit-parameters.ts",
    "refund": "ts-node --files ./scripts/refund.ts",
    "format": "yarn run lint && prettier --check .",
    "format:fix": "yarn run lint:fix && prettier --write .",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "test": "mocha --exit --recursive 'test/**/*.test.ts'",
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "docs": "typedoc --options typedoc.json"
  },
  "files": [
    "dist/",
    "src/",
    "patches/"
  ],
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.0.5",
    "@coral-xyz/anchor": "^0.32.1",
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/abstract-provider": "^5.7.0",
    "@ethersproject/abstract-signer": "^5.7.0",
    "@ethersproject/address": "^5.7.0",
    "@ethersproject/bignumber": "^5.7.0",
    "@ethersproject/bytes": "^5.7.0",
    "@ethersproject/constants": "^5.7.0",
    "@ethersproject/contracts": "^5.7.0",
    "@ethersproject/sha2": "^5.7.0",
    "@ethersproject/solidity": "^5.7.0",
    "@keep-network/ecdsa": "2.1.0-dev.19",
    "@keep-network/tbtc-v2": "1.8.0-dev.1",
    "@mysten/sui": "1.34.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "~1.97.0",
    "axios": "^1.9.0",
    "bitcoinjs-lib": "^6.1.5",
    "bufio": "^1.0.6",
    "ecpair": "^2.1.0",
    "electrum-client-js": "git+https://github.com/keep-network/electrum-client-js.git#v0.2.0",
    "p-timeout": "^4.1.0",
    "patch-package": "8.0.0",
    "starknet": "^6.24.1",
    "url-parse": "^1.5.10",
    "viem": "^2.21.0",
    "wif": "2.0.6"
  },
  "devDependencies": {
    "@keep-network/prettier-config-keep": "github:keep-network/prettier-config-keep",
    "@types/chai": "^4.2.21",
    "@types/chai-as-promised": "^7.1.4",
    "@types/mocha": "^8.2.3",
    "@types/node": "18",
    "@types/sinon": "^17.0.4",
    "@types/url-parse": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "chai": "^4.3.4",
    "chai-as-promised": "^7.1.1",
    "commander": "^9.4.0",
    "eslint": "^7.30.0",
    "eslint-config-keep": "github:keep-network/eslint-config-keep",
    "ethereum-waffle": "4.0.0-alpha.25",
    "ethers": "^5.5.2",
    "mocha": "^9.0.2",
    "prettier": "^2.3.2",
    "sinon": "^20.0.0",
    "ts-node": "^10.8.0",
    "typedoc": "^0.25.3",
    "typedoc-plugin-markdown": "^3.17.0",
    "typescript": "^5.0.0"
  },
  "resolutions": {
    "crypto-js": "4.2.0",
    "secp256k1": "4.0.3",
    "@solana/web3.js": "1.97.0"
  },
  "overrides": {
    "secp256k1": "4.0.3",
    "@solana/web3.js": "1.97.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.12.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/keep-network/tbtc-v2.git",
    "directory": "typescript"
  }
}
